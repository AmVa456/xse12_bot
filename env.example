# Telegram Bot
BOT_TOKEN=

# Webhook
WEBHOOK_URL=
WEBHOOK_SECRET=
AUTO_SET_WEBHOOK=true

# State / Storage
DB_URL=sqlite://./xseries.db
REDIS_URL=redis://localhost:6379

# Local Bot API (self-hosted)
LOCAL_BOT_API_BASE_URL=http://127.0.0.1:8081

# Telegram Web Login OAuth-style flow
TELEGRAM_LOGIN_BOT_USERNAME=
TELEGRAM_LOGIN_AUTH_DOMAIN=
TELEGRAM_LOGIN_CALLBACK_URL=
TELEGRAM_LOGIN_MAX_AGE_SECONDS=300
SESSION_SECRET=

# Admin bootstrap (comma-separated telegram IDs)
ADMIN_TELEGRAM_IDS=

# Runtime
NODE_ENV=development
PORT=8080
