{
  "name": "xseries-telegram-connector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "register:bot": "tsx src/tools/registerBot.ts",
    "init:path": "bash scripts/init-path.sh",
    "dist:control-contract": "node dist/tools/control_plane_contract.js",
    "dist:gateway-smoke": "node dist/tools/php_gateway_smoke.js",
    "test": "tsx --test tests/**/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.3.0",
    "fastify-plugin": "^5.0.1",
    "ioredis": "^5.4.2",
    "node-fetch": "^3.3.2",
    "pino": "^9.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.10",
    "pm2": "^7.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5",
    "typescript": "^5.8.2"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.9.0"
  }
